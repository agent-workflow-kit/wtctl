{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/cli/cron-uninstall.json",
  "title": "wtctl cron uninstall --json",
  "type": "object",
  "properties": {
    "installed": {
      "const": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A crontab line of the managed block."
      },
      "description": "The removed lines."
    },
    "dry_run": {
      "type": "boolean",
      "description": "true: what the command would do; nothing was changed and no hooks ran."
    }
  },
  "additionalProperties": false,
  "required": [
    "installed",
    "entries",
    "dry_run"
  ]
}
