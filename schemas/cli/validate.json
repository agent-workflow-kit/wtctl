{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/cli/validate.json",
  "title": "wtctl validate --json",
  "type": "object",
  "properties": {
    "checks": {
      "type": "object",
      "properties": {
        "root": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "../defs.json#/$defs/abs_path",
              "description": "The configured root, expanded and normalized."
            },
            "exists": {
              "type": "boolean",
              "description": "false: the directory does not exist yet but can be created (a nearest existing ancestor is a writable directory)."
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "exists"
          ]
        },
        "search_roots": {
          "type": "array",
          "maxItems": 50,
          "description": "One entry per search_roots entry, in config order; at most the first 50 are checked (search_roots_truncated).",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "../defs.json#/$defs/abs_path"
              },
              "status": {
                "enum": [
                  "ok",
                  "missing",
                  "not_directory",
                  "unreadable"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "status"
            ]
          }
        },
        "git": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "../defs.json#/$defs/abs_path",
              "description": "The git binary used (git_bin, else the first absolute PATH entry with git)."
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)*$"
            },
            "minimum": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)*$"
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "version",
            "minimum"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "root",
        "search_roots",
        "git"
      ]
    },
    "warnings": {
      "type": "array",
      "description": "Empty when there is nothing to say. Each entry is an object, unlike the string warnings of other commands.",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "search_root_missing",
              "search_root_unusable",
              "search_roots_truncated",
              "probe_clone_failed",
              "probe_token_failed",
              "probe_remote_failed",
              "probe_truncated",
              "probe_deadline",
              "probe_unavailable"
            ],
            "description": "The probe_* codes only appear with --probe."
          },
          "message": {
            "type": "string",
            "maxLength": 400,
            "x-untrusted": true,
            "description": "Human-readable; embeds config values (escaped and cut to 200 characters)."
          },
          "key": {
            "type": "string",
            "description": "The config key the warning is about, e.g. search_roots[2]."
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ]
      }
    },
    "probe": {
      "type": "object",
      "description": "Only with --probe: live checks. A failed entry is also a warning; the exit code is not changed.",
      "properties": {
        "clones": {
          "type": "array",
          "maxItems": 20,
          "description": "Each configured repos.<id>.clone is a clone whose remote names the repo.",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "failed",
                  "skipped"
                ]
              },
              "reason": {
                "enum": [
                  "missing",
                  "not_a_clone",
                  "deadline",
                  "workdir_unavailable",
                  "internal_error"
                ]
              },
              "repo": {
                "type": "string",
                "description": "From the validated config."
              }
            },
            "additionalProperties": false,
            "required": [
              "repo",
              "status"
            ]
          }
        },
        "tokens": {
          "type": "array",
          "maxItems": 20,
          "description": "Each hosts.<host> token source yields a usable token (never shown).",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "failed",
                  "skipped"
                ]
              },
              "reason": {
                "enum": [
                  "no_token_source",
                  "token_unavailable",
                  "token_invalid",
                  "deadline",
                  "workdir_unavailable",
                  "internal_error"
                ]
              },
              "host": {
                "type": "string",
                "description": "From the validated config."
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "status"
            ]
          }
        },
        "remotes": {
          "type": "array",
          "maxItems": 20,
          "description": "Each configured repo's HTTPS remote answers ls-remote.",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "failed",
                  "skipped"
                ]
              },
              "reason": {
                "enum": [
                  "auth_required",
                  "token_rejected",
                  "timeout",
                  "network_unreachable",
                  "repository_not_found",
                  "rate_limited",
                  "git_failed",
                  "invalid_url",
                  "embedded_credentials",
                  "ssh_not_probed",
                  "local_remote",
                  "deadline",
                  "workdir_unavailable",
                  "internal_error"
                ]
              },
              "repo": {
                "type": "string",
                "description": "From the validated config."
              },
              "host": {
                "type": "string",
                "description": "The host (with a non-default port) the URL names; absent on an entry skipped before its URL was read."
              }
            },
            "additionalProperties": false,
            "required": [
              "repo",
              "status"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "clones",
        "tokens",
        "remotes"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "checks",
    "warnings"
  ]
}
