{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/hooks/post-baseline-accept.json",
  "title": "wtctl post-baseline-accept hook payload",
  "type": "object",
  "properties": {
    "tool": {
      "const": "wtctl"
    },
    "object_type": {
      "$ref": "../defs.json#/$defs/object_type"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "hook": {
      "const": "post-baseline-accept"
    },
    "record": {
      "$ref": "../defs.json#/$defs/record"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/baseline_item"
      }
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "hook",
    "record",
    "items",
    "actor"
  ]
}
