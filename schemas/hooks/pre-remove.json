{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/hooks/pre-remove.json",
  "title": "wtctl pre-remove hook payload",
  "type": "object",
  "properties": {
    "tool": {
      "const": "wtctl"
    },
    "object_type": {
      "$ref": "../defs.json#/$defs/object_type"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "hook": {
      "const": "pre-remove"
    },
    "record": {
      "$ref": "../defs.json#/$defs/record"
    },
    "checks": {
      "$ref": "../defs.json#/$defs/checks"
    },
    "merged_head": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "overridden": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/forceable_check"
      },
      "uniqueItems": true,
      "description": "The checks a human --force overrides; empty when nothing is forced."
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids",
      "description": "From --decision-id."
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "hook",
    "record",
    "checks",
    "merged_head",
    "overridden",
    "actor",
    "decision_ids"
  ]
}
