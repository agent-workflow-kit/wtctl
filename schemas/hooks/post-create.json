{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/hooks/post-create.json",
  "title": "wtctl post-create hook payload",
  "description": "Also fires after bootstrap_failed.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "wtctl"
    },
    "object_type": {
      "$ref": "../defs.json#/$defs/object_type"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "hook": {
      "const": "post-create"
    },
    "record": {
      "$ref": "../defs.json#/$defs/record"
    },
    "bootstrap": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/bootstrap_result"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "hook",
    "record",
    "bootstrap"
  ]
}
