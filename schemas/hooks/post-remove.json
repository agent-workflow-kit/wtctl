{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/hooks/post-remove.json",
  "title": "wtctl post-remove hook payload",
  "type": "object",
  "properties": {
    "tool": {
      "const": "wtctl"
    },
    "object_type": {
      "$ref": "../defs.json#/$defs/object_type"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "hook": {
      "const": "post-remove"
    },
    "record": {
      "$ref": "../defs.json#/$defs/record"
    },
    "branch_deleted": {
      "type": "boolean"
    },
    "branch_kept_reason": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/branch_kept_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "overridden": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/forceable_check"
      },
      "uniqueItems": true,
      "description": "The checks a human --force overrode; empty when nothing was forced."
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "hook",
    "record",
    "branch_deleted",
    "branch_kept_reason",
    "overridden"
  ]
}
