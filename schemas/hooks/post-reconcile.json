{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtctl/hooks/post-reconcile.json",
  "title": "wtctl post-reconcile hook payload",
  "description": "Fires when reconcile changed something.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "wtctl"
    },
    "object_type": {
      "const": "reconcile"
    },
    "object_id": {
      "type": "null"
    },
    "repo": {
      "type": "null"
    },
    "labels": {
      "type": "array",
      "maxItems": 0
    },
    "hook": {
      "const": "post-reconcile"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/change"
      },
      "minItems": 1
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/report"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "hook",
    "changes",
    "reports"
  ]
}
